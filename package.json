{
  "name": "killeros",
  "version": "1.4.6",
  "description": "A production-hardened TUI and workflow extension for the Pi coding agent.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "tui"
  ],
  "author": "KyrosHendrix",
  "license": "MIT",
  "homepage": "https://github.com/KyrosHendrix/pi-KillerOS#readme",
  "bugs": {
    "url": "https://github.com/KyrosHendrix/pi-KillerOS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyrosHendrix/pi-KillerOS.git"
  },
  "files": [
    "Killeros.ts",
    "subagents.ts",
    "subagent-lifecycle.ts",
    "subagent-process.ts",
    "subagent-ui.ts",
    "agents/*.md",
    "themes/killeros.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.js"
  },
  "pi": {
    "extensions": [
      "./Killeros.ts"
    ],
    "themes": [
      "./themes/killeros.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "pi-web-access": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/node": "24.12.4",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  }
}
