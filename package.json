{
  "name": "killeros",
  "version": "4.0.0",
  "description": "A Windows terminal UI for the Pi coding agent with session handoff, configurable auto-compaction, OpenAI fast mode, and persistent goals.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "ai-coding",
    "tui",
    "terminal-ui",
    "context-management",
    "session-management",
    "windows"
  ],
  "author": "KyrosHendrix",
  "license": "MIT",
  "homepage": "https://github.com/KyrosHendrix/pi-KillerOS#readme",
  "bugs": {
    "url": "https://github.com/KyrosHendrix/pi-KillerOS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyrosHendrix/pi-KillerOS.git"
  },
  "files": [
    "Killeros.ts",
    "killeros/*.ts",
    "themes/killeros.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "benchmark:change-receipt": "node --test --experimental-strip-types test/ChangeReceipt.bench.ts",
    "check": "tsc --noEmit && eslint .",
    "lint": "eslint .",
    "prepublishOnly": "node --experimental-strip-types scripts/verify-release.ts",
    "test": "node --test --test-concurrency=4 --test-force-exit --experimental-strip-types --import ./test/support/TestTemp.ts test/*.test.*",
    "test:changed": "node --experimental-strip-types scripts/test-changed.ts"
  },
  "pi": {
    "extensions": [
      "./Killeros.ts"
    ],
    "themes": [
      "./themes/killeros.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.0 <2",
    "@earendil-works/pi-coding-agent": ">=1.5.0 <2",
    "@earendil-works/pi-tui": ">=1.5.0 <2",
    "typebox": ">=1.1.38 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "24.12.4",
    "@xterm/headless": "6.0.0",
    "eslint": "^10.9.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "zigpty": "0.2.1"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "undici": "8.12.3",
    "minimatch": "11.0.1"
  }
}
